# Generate static_abi_mods.cpp — the tip's table of static-ABI packs (WASM).
#
# Each STATIC_ABI pack (qtclient_add_mod) defines, through
# QTCLIENT_MOD_DEFINE_REGISTER(<c_id>) with QTCLIENT_MOD_STATIC_ABI:
#   extern "C" void qtclient_mod_<c_id>_register_abi(const QtClientHostApiV1*, const QtClientModLoadCtx*);
# ModLoader (client/tibia/mods/modloader.cpp) walks this table and calls the entry
# whose id matches a pack's mod.json "id", with the same api/ctx as a MODULE's
# qtclient_mod_register. The table only names the entries; it calls nothing itself.
#
# Expects: STATIC_ABI_MOD_IDS (mod.json ids), OUTPUT.

if(NOT DEFINED STATIC_ABI_MOD_IDS OR STATIC_ABI_MOD_IDS STREQUAL "")
  message(FATAL_ERROR "GenerateStaticAbiMods.cmake: STATIC_ABI_MOD_IDS empty")
endif()
if(NOT DEFINED OUTPUT OR OUTPUT STREQUAL "")
  message(FATAL_ERROR "GenerateStaticAbiMods.cmake: OUTPUT empty")
endif()

set(_body [=[
// Generated by cmake/GenerateStaticAbiMods.cmake — do not edit.
#include "qtclient/abi/host_api_v1.h"

#include <cstddef>
#include <cstring>

extern "C" {
]=])

foreach(_id IN LISTS STATIC_ABI_MOD_IDS)
  string(MAKE_C_IDENTIFIER "${_id}" _c_id)
  string(APPEND _body "void qtclient_mod_${_c_id}_register_abi(const QtClientHostApiV1* api, const QtClientModLoadCtx* ctx);\n")
endforeach()

string(APPEND _body [=[
}

namespace {

using RegisterFn = void (*)(const QtClientHostApiV1*, const QtClientModLoadCtx*);

struct StaticAbiMod {
    const char* id;
    RegisterFn registerAbi;
};

const StaticAbiMod kStaticAbiMods[] = {
]=])
foreach(_id IN LISTS STATIC_ABI_MOD_IDS)
  string(MAKE_C_IDENTIFIER "${_id}" _c_id)
  string(APPEND _body "    {\"${_id}\", &qtclient_mod_${_c_id}_register_abi},\n")
endforeach()
string(APPEND _body [=[
};

} // namespace

/// Number of static-ABI packs linked into this tip.
extern "C" std::size_t qtclient_static_abi_mod_count()
{
    return sizeof(kStaticAbiMods) / sizeof(kStaticAbiMods[0]);
}

/// mod.json "id" of entry `index` (nullptr past the end).
extern "C" const char* qtclient_static_abi_mod_id(std::size_t index)
{
    return index < qtclient_static_abi_mod_count() ? kStaticAbiMods[index].id : nullptr;
}

/// The register entry for pack `id` (nullptr when that pack is not linked statically).
extern "C" void (*qtclient_static_abi_mod_entry(const char* id))(const QtClientHostApiV1*, const QtClientModLoadCtx*)
{
    if (!id)
        return nullptr;
    for (const StaticAbiMod& mod : kStaticAbiMods) {
        if (std::strcmp(mod.id, id) == 0)
            return mod.registerAbi;
    }
    return nullptr;
}
]=])

file(WRITE "${OUTPUT}.tmp" "${_body}")
# Rewrite only on change so the tip does not recompile the table every configure.
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
