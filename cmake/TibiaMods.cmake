# Mods/: optional packs with mod.json — runtime MODULE (host-pushed C ABI) or
# deprecated ABSORB_INTO_TIP into tibia.
#
#   client/mods/<name>/mod.json + CMakeLists.txt
#   -DQTCLIENT_LINKED_PACK=<pack>/client              # out-of-tree pack client/
#   -DQTCLIENT_LINKED_PACKS=<a>/client;<b>/client     # multi-pack
#
# Runtime: mods/<id>/ (qml/overrides + native/mod.*). ModLoader dlopens native
# and calls qtclient_mod_register(api, ctx). No tip export allowlist.

option(QTCLIENT_ENABLE_MODS "Discover and link mods/ packs into tibia" ON)
option(QTCLIENT_PACK_SDK_ONLY "Packs compile against client-sdk only (no tip includes)" OFF)
set(QTCLIENT_MODS_DIR "${TIBIA_ROOT}/client/mods" CACHE PATH "Directory containing client/mods/<name>/")
set(QTCLIENT_MODS "" CACHE STRING "Semicolon list of mod names to enable (empty = all non-template)")
set(QTCLIENT_LINKED_PACK "" CACHE PATH "External pack client/ dir to STATIC-link into tibia (singular)")
set(QTCLIENT_LINKED_PACKS "" CACHE STRING "Semicolon list of external pack client/ dirs (multi-pack)")
set(QTCLIENT_LINKED_PACK_LIBS "" CACHE STRING "Semicolon list of id=/path/to/libqtclient_mod_<id>.a")

function(tibia_list_mods out_var)
  set(names "")
  if(EXISTS "${QTCLIENT_MODS_DIR}")
    file(GLOB _mod_dirs LIST_DIRECTORIES true "${QTCLIENT_MODS_DIR}/*")
    foreach(d IN LISTS _mod_dirs)
      if(IS_DIRECTORY "${d}" AND EXISTS "${d}/mod.json")
        get_filename_component(n "${d}" NAME)
        list(APPEND names "${n}")
      endif()
    endforeach()
  endif()
  set(${out_var} "${names}" PARENT_SCOPE)
endfunction()

function(tibia_mod_is_template mod_name out_var)
  string(SUBSTRING "${mod_name}" 0 1 _first)
  if(_first STREQUAL "_")
    set(${out_var} TRUE PARENT_SCOPE)
  else()
    set(${out_var} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(tibia_resolve_enabled_mods)
  set(enabled "")
  if(NOT QTCLIENT_ENABLE_MODS)
    set(QTCLIENT_ENABLED_MODS "${enabled}" PARENT_SCOPE)
    return()
  endif()
  tibia_list_mods(_all)
  if(QTCLIENT_MODS)
    foreach(n IN LISTS QTCLIENT_MODS)
      if(n IN_LIST _all)
        list(APPEND enabled "${n}")
      else()
        message(WARNING "qtclient mods: '${n}' listed in QTCLIENT_MODS but not found under ${QTCLIENT_MODS_DIR}")
      endif()
    endforeach()
  else()
    foreach(n IN LISTS _all)
      tibia_mod_is_template("${n}" _tmpl)
      if(NOT _tmpl)
        list(APPEND enabled "${n}")
      endif()
    endforeach()
  endif()
  set(QTCLIENT_ENABLED_MODS "${enabled}" PARENT_SCOPE)
endfunction()

function(tibia_linked_pack_dirs out_var)
  set(_dirs "")
  if(QTCLIENT_LINKED_PACKS)
    foreach(_p IN LISTS QTCLIENT_LINKED_PACKS)
      if(_p)
        list(APPEND _dirs "${_p}")
      endif()
    endforeach()
  endif()
  if(QTCLIENT_LINKED_PACK)
    list(APPEND _dirs "${QTCLIENT_LINKED_PACK}")
  endif()
  list(REMOVE_DUPLICATES _dirs)
  set(${out_var} "${_dirs}" PARENT_SCOPE)
endfunction()

function(tibia_add_mod_subdirectory mod_name)
  set(dir "${QTCLIENT_MODS_DIR}/${mod_name}")
  if(NOT EXISTS "${dir}/CMakeLists.txt")
    message(STATUS "qtclient mods: ${mod_name} has mod.json but no CMakeLists.txt — skip link")
    return()
  endif()
  # Skip if the same pack is already QTCLIENT_LINKED_PACK(S) (same realpath).
  tibia_linked_pack_dirs(_linked_dirs)
  get_filename_component(_dir_abs "${dir}" ABSOLUTE)
  get_filename_component(_dir_real "${_dir_abs}" REALPATH)
  foreach(_linked IN LISTS _linked_dirs)
    get_filename_component(_linked_abs "${_linked}" ABSOLUTE)
    get_filename_component(_linked_real "${_linked_abs}" REALPATH)
    if(_dir_real STREQUAL _linked_real)
      message(STATUS "qtclient mods: ${mod_name} is QTCLIENT_LINKED_PACK(S) — skip in-tree duplicate")
      return()
    endif()
  endforeach()
  message(STATUS "qtclient mods: enabling ${mod_name}")
  add_subdirectory("${dir}" "${CMAKE_CURRENT_BINARY_DIR}/mods/${mod_name}")
endfunction()

function(tibia_add_linked_pack_dir _linked _index)
  get_filename_component(_linked_abs "${_linked}" ABSOLUTE)
  if(EXISTS "${_linked_abs}/CMakeLists.txt" AND EXISTS "${_linked_abs}/mod.json")
    message(STATUS "qtclient mods: QTCLIENT_LINKED_PACK=${_linked_abs}")
    set(_brand "${_linked_abs}/brand.cmake")
    if(EXISTS "${_brand}")
      include("${_brand}")
    endif()
    add_subdirectory("${_linked_abs}" "${CMAKE_CURRENT_BINARY_DIR}/mods/_linked_pack_${_index}")
  else()
    message(FATAL_ERROR "QTCLIENT_LINKED_PACK=${_linked} needs CMakeLists.txt + mod.json")
  endif()
endfunction()

function(tibia_add_enabled_mods)
  include("${TIBIA_ROOT}/cmake/QtClientMod.cmake")
  tibia_resolve_enabled_mods()
  foreach(_qt_mod IN LISTS QTCLIENT_ENABLED_MODS)
    set(_brand "${QTCLIENT_MODS_DIR}/${_qt_mod}/brand.cmake")
    if(EXISTS "${_brand}")
      include("${_brand}")
    endif()
    tibia_add_mod_subdirectory("${_qt_mod}")
  endforeach()

  # Out-of-tree product packs — same STATIC link path (singular + plural).
  set(_idx 0)
  if(QTCLIENT_ENABLE_MODS)
    tibia_linked_pack_dirs(_linked_dirs)
    foreach(_linked IN LISTS _linked_dirs)
      tibia_add_linked_pack_dir("${_linked}" "${_idx}")
      math(EXPR _idx "${_idx}+1")
    endforeach()

    # Phase 3: prebuilt archives id=/path/to.a
    foreach(_spec IN LISTS QTCLIENT_LINKED_PACK_LIBS)
      if(_spec STREQUAL "")
        continue()
      endif()
      string(REPLACE "=" ";" _parts "${_spec}")
      list(LENGTH _parts _n)
      if(NOT _n EQUAL 2)
        message(FATAL_ERROR "QTCLIENT_LINKED_PACK_LIBS entry must be id=/path/to.a (got '${_spec}')")
      endif()
      list(GET _parts 0 _lib_id)
      list(GET _parts 1 _lib_path)
      set(_mod_dir "")
      get_filename_component(_lib_dir "${_lib_path}" DIRECTORY)
      # Common layouts: …/mods/<id>/lib/lib….a or …/libqtclient_mod_<id>.a next to mods/<id>
      if(EXISTS "${_lib_dir}/../mod.json")
        get_filename_component(_mod_dir "${_lib_dir}/.." ABSOLUTE)
      elseif(EXISTS "${_lib_dir}/mods/${_lib_id}/mod.json")
        set(_mod_dir "${_lib_dir}/mods/${_lib_id}")
      endif()
      qtclient_link_mod_archive(${_lib_id} ARCHIVE "${_lib_path}" MOD_DIR "${_mod_dir}")
    endforeach()
  endif()

  tibia_linked_pack_dirs(_any_linked)
  if(QTCLIENT_ENABLE_MODS AND QTCLIENT_ENABLED_MODS STREQUAL "" AND NOT _any_linked AND NOT QTCLIENT_LINKED_PACK_LIBS)
    message(STATUS "qtclient mods: enabled, none discovered (stock CIP)")
  endif()
  set(TIBIA_PRODUCT_NAME "${TIBIA_PRODUCT_NAME}" PARENT_SCOPE)
  set(TIBIA_PRODUCT_ORG "${TIBIA_PRODUCT_ORG}" PARENT_SCOPE)
  set(TIBIA_PRODUCT_URL "${TIBIA_PRODUCT_URL}" PARENT_SCOPE)
  set(TIBIA_DEFAULT_CDN "${TIBIA_DEFAULT_CDN}" PARENT_SCOPE)
  set(TIBIA_CLIENT_PACKAGE_DIR "${TIBIA_CLIENT_PACKAGE_DIR}" PARENT_SCOPE)
  if(DEFINED TIBIA_PRODUCT_BUNDLE_ID)
    set(TIBIA_PRODUCT_BUNDLE_ID "${TIBIA_PRODUCT_BUNDLE_ID}" PARENT_SCOPE)
  endif()
  set(QTCLIENT_ENABLED_MODS "${QTCLIENT_ENABLED_MODS}" PARENT_SCOPE)
endfunction()

# Generate deprecated linked_mods.cpp (ABSORB) + stage FS/native packs next to tip.
# Must run from the directory that created target `tibia` (after tibia_add_enabled_mods).
function(tibia_apply_linked_pack_staging)
  if(NOT TARGET tibia)
    message(FATAL_ERROR "tibia_apply_linked_pack_staging: target tibia missing")
  endif()

  get_property(_ids GLOBAL PROPERTY QTCLIENT_LINKED_MOD_IDS)
  if(_ids)
    list(REMOVE_DUPLICATES _ids)
    set(_gen_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
    file(MAKE_DIRECTORY "${_gen_dir}")
    set(_gen "${_gen_dir}/linked_mods.cpp")
    set(LINKED_MOD_IDS "${_ids}")
    set(OUTPUT "${_gen}")
    include("${TIBIA_ROOT}/cmake/GenerateLinkedMods.cmake")
    target_sources(tibia PRIVATE "${_gen}")
    target_compile_definitions(tibia PRIVATE QTCLIENT_HAS_LINKED_PACK=1)
    if(EMSCRIPTEN OR WASM)
      target_link_options(tibia PRIVATE "LINKER:--undefined=qtclient_invoke_linked_mods")
      foreach(_id IN LISTS _ids)
        target_link_options(tibia PRIVATE "LINKER:--undefined=qtclient_mod_${_id}_entry")
      endforeach()
    endif()
    message(STATUS "qtclient mods: linked entry table (deprecated absorb) ← ${_ids}")
  endif()

  get_property(_runtime_ids GLOBAL PROPERTY QTCLIENT_RUNTIME_MOD_IDS)
  if(_runtime_ids AND (EMSCRIPTEN OR WASM))
    # Runtime MODULE load via dlopen — tip must be MAIN_MODULE; packs are SIDE_MODULE.
    # Packs import zero tip symbols (host-pushed API); no tip export allowlist.
    target_link_options(tibia PRIVATE
      "SHELL:-sMAIN_MODULE=2"
      "SHELL:-sERROR_ON_UNDEFINED_SYMBOLS=0")
    target_compile_definitions(tibia PRIVATE QTCLIENT_HAS_RUNTIME_MODS=1)
    message(STATUS "qtclient mods: WASM MAIN_MODULE=2 for runtime packs ← ${_runtime_ids}")
  elseif(_runtime_ids)
    target_compile_definitions(tibia PRIVATE QTCLIENT_HAS_RUNTIME_MODS=1)
    message(STATUS "qtclient mods: runtime MODULE packs ← ${_runtime_ids}")
  endif()

  get_property(_stages GLOBAL PROPERTY QTCLIENT_MOD_TIP_STAGE)
  foreach(_entry IN LISTS _stages)
    string(REPLACE "|" ";" _parts "${_entry}")
    list(GET _parts 0 _mod_id)
    list(GET _parts 1 _outdir)
    set(_resources_dir "")
    set(_mod_target "")
    list(LENGTH _parts _nparts)
    if(_nparts GREATER 2)
      list(GET _parts 2 _resources_dir)
    endif()
    if(_nparts GREATER 3)
      list(GET _parts 3 _mod_target)
    endif()
    set(_refresh_res_cmds "")
    if(_resources_dir AND EXISTS "${_resources_dir}")
      set(_refresh_res_cmds
        COMMAND ${CMAKE_COMMAND} -E rm -rf "${_outdir}/resources"
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${_resources_dir}" "${_outdir}/resources"
      )
    endif()
    # Ensure MODULE is built before tip staging copies native/.
    if(_mod_target AND TARGET ${_mod_target})
      add_dependencies(tibia ${_mod_target})
    endif()
    # Drop empty native/ left over from absorb packs (MODULE packs keep mod.*).
    add_custom_command(TARGET tibia POST_BUILD
      ${_refresh_res_cmds}
      COMMAND ${CMAKE_COMMAND} -E rm -rf "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}"
      COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}"
      COMMAND ${CMAKE_COMMAND} -E copy_directory "${_outdir}" "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}"
      COMMAND ${CMAKE_COMMAND} -E rm -rf "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}/lib"
      COMMAND ${CMAKE_COMMAND}
        -DNATIVE_DIR="$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}/native"
        -P "${TIBIA_ROOT}/cmake/ScrubEmptyNative.cmake"
      COMMENT "install ${_mod_id} pack (FS + native) next to tip")
  endforeach()
endfunction()
