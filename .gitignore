## Extract / tip data (generated; not committed)
#################
# C5 kind-A dump (make dump → QTCLIENT_CIPSOFT_DIR)
/cipsoft/

/data/sounds/*/
!/data/sounds/qtclient/
!/data/sounds/qtclient/**
/data/sounds/catalog-sound.json
/data/sounds/sound-*.ogg
/data/sounds/sounds-*.dat
/data/assets/
/data/aac/
/data/storeimages/
# Qt QML plugins come from `make qt`, not this tree
/data/qml/

# Public CIP-clone spin-out also ignores /upstream/ (builders run make tibia-sync).
# This private qtclient fork keeps upstream/ tracked — see README.md (Layout).
# /upstream/

# Stock tracks default packs only. Product packs STATIC-link via
# QTCLIENT_LINKED_PACK and stage tip mods/<id>/ at build time.
/client/mods/*
!/client/mods/README.md
!/client/mods/qtc-aac/
!/client/mods/qtc-aac/**
/launcher/mods/*
!/launcher/mods/.gitkeep

