{
  "id": "myaac",
  "name": "myAAC login",
  "version": "1.0.0",
  "autoload": true,
  "priority": 50,
  "QTCLIENT_MOD_API": 1,
  "description": "Default tip pack — myAAC http://127.0.0.1/login.php. Product tips replace urls via idleot (lower priority).",
  "urls": {
    "loginBase": "http://127.0.0.1",
