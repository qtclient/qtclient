    "clientServicesPath": "/login.php",
    "createAccountPath": "/login.php",
    "pages": {
      "QTCLIENT_URL_CREATE_ACCOUNT": "/?subtopic=createaccount",
      "QTCLIENT_URL_ACCESS_ACCOUNT": "/?subtopic=accountmanagement",
      "QTCLIENT_URL_LOST_ACCOUNT": "/?subtopic=lostaccount"
    }
  }
}
