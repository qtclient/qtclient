{
  "id": "qtc-aac",
  "name": "qtc-aac login",
  "version": "1.0.0",
  "autoload": true,
  "priority": 50,
  "QTCLIENT_MOD_API": 1,
  "description": "Default tip pack — qtc-aac (https://github.com/qtclient/qtc-aac) at http://127.0.0.1:5173. Product tips replace urls via pack (lower priority).",
  "urls": {
    "loginBase": "http://127.0.0.1:5173",
    "loginPath": "/clientservices/loginservice.php",
    "clientServicesPath": "/clientservices/clientservices.php",
    "createAccountPath": "/clientservices/accountcreationclientservices.php",
    "pages": {
      "QTCLIENT_URL_CREATE_ACCOUNT": "/account/signup",
      "QTCLIENT_URL_ACCESS_ACCOUNT": "/account",
      "QTCLIENT_URL_LOST_ACCOUNT": "/account/lost"
    }
  }
}
