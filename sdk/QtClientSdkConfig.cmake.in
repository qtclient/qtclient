# QtClientSdk — qtclient pack SDK (generated by apps/qtclient/sdk/CMakeLists.txt).
#
#   find_package(QtClientSdk 9 REQUIRED)   # major = host ABI version
#   find_package(Qt6 … )                   # the SAME kit (QTCLIENT_SDK_QT_PREFIX)
#   qtclient_add_mod(<id> SOURCES …)
#   qtclient_mod_install(<id>)
#
# A pack sees only include/qtclient/abi (QtClientSdk::Abi). No host sources, no tip targets.
@PACKAGE_INIT@

set(QTCLIENT_SDK_ROOT "${PACKAGE_PREFIX_DIR}")
set_and_check(QTCLIENT_SDK_INCLUDE_DIR "@PACKAGE_QTCLIENT_SDK_INCLUDE_INSTALL_DIR@")
set(QTCLIENT_SDK_ABI_VERSION "@QTCLIENT_SDK_ABI_VERSION@")
set(QTCLIENT_SDK_HOST_BUILD_ID "@QTCLIENT_SDK_HOST_BUILD_ID@")
set(QTCLIENT_SDK_QT_VERSION "@QTCLIENT_SDK_QT_VERSION@")
set(QTCLIENT_SDK_QT_PREFIX "@QTCLIENT_SDK_QT_PREFIX@")
set(QTCLIENT_SDK_QT_STATIC @QTCLIENT_SDK_QT_STATIC@)
set(QTCLIENT_SDK_PLATFORM "@QTCLIENT_SDK_PLATFORM@")
set(QTCLIENT_SDK_PACK_MODE "@QTCLIENT_SDK_PACK_MODE@")
set(QTCLIENT_SDK_SCRIPTS_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/qtclient-sdk/scripts")

# The SDK is per platform: a wasm SDK for wasm packs, a desktop SDK for desktop packs.
if(QTCLIENT_SDK_PLATFORM STREQUAL "wasm")
  if(NOT (EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "Emscripten"))
    set(QtClientSdk_FOUND FALSE)
    set(QtClientSdk_NOT_FOUND_MESSAGE "this QtClientSdk is for wasm (configure with the wasm Qt toolchain)")
    return()
  endif()
elseif(EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
  set(QtClientSdk_FOUND FALSE)
  set(QtClientSdk_NOT_FOUND_MESSAGE "this QtClientSdk is for ${QTCLIENT_SDK_PLATFORM}, not wasm")
  return()
endif()

if(NOT TARGET QtClientSdk::Abi)
  add_library(QtClientSdk::Abi INTERFACE IMPORTED)
  set_target_properties(QtClientSdk::Abi PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${QTCLIENT_SDK_INCLUDE_DIR}")
endif()

# Hint the recorded kit; qtclient_add_mod fails if the found Qt is another version.
if(QTCLIENT_SDK_QT_PREFIX AND EXISTS "${QTCLIENT_SDK_QT_PREFIX}/lib/cmake/Qt6")
  list(APPEND CMAKE_PREFIX_PATH "${QTCLIENT_SDK_QT_PREFIX}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/QtClientMod.cmake")
check_required_components(QtClientSdk)
